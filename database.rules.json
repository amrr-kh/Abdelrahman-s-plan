{
  "rules": {
    ".read": false,
    ".write": false,
    "drivers": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChild('name')",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "plate": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "busSign": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "license": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "$other": {
          ".validate": false
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === \"active\" || newData.val() === \"inactive\")"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "licenseExpiry": {
          ".validate": "newData.isString() && (newData.val() === \"\" || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
        }
      }
    },
    "workOrders": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['driverId', 'driverName', 'date', 'workOrder', 'photoUrl', 'timestamp'])",
        "driverId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "driverName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "sheetName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "workOrder": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "photoUrl": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.*/) && newData.val().length <= 500"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "attendance": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren([\"driverId\", \"date\", \"timestamp\"])",
        "driverId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "startTime": {
          ".validate": "newData.isString() && (newData.val() === \"\" || newData.val().matches(/^[0-9]{2}:[0-9]{2}$/))"
        },
        "endTime": {
          ".validate": "newData.isString() && (newData.val() === \"\" || newData.val().matches(/^[0-9]{2}:[0-9]{2}$/))"
        },
        "shiftType": {
          ".validate": "newData.isString() && (newData.val() === \"half\" || newData.val() === \"normal\" || newData.val() === \"extra\" || newData.val() === \"custom\" || newData.val() === \"none\")"
        },
        "driverName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "plate": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "busSign": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "route": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === \"present\" || newData.val() === \"off\" || newData.val() === \"sick\")"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "updatedBy": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "startTime": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
      },
      "halfEnd": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
      },
      "normalEnd": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
      },
      "extraEnd": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
      },
      "$other": {
        ".validate": false
      }
    },
    "vehicles": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChild('plate')",
        "plate": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "busSign": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "model": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "insuranceExpiry": {
          ".validate": "newData.isString() && (newData.val() === \"\" || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
        },
        "licenseExpiry": {
          ".validate": "newData.isString() && (newData.val() === \"\" || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
        },
        "nextMaintenance": {
          ".validate": "newData.isString() && (newData.val() === \"\" || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === \"active\" || newData.val() === \"inactive\")"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
